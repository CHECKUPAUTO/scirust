# Generated by the Dioxus Web build (`dx build --platform web`).
/dist/*
!/dist/.gitkeep

# Prepared by tools/prepare-sidecar from the worker this repo builds.
# Never committed: it is a 30 MB binary that is reproduced by one command,
# and a checked-in executable is a supply-chain question nobody wants.
/src-tauri/binaries/*
!/src-tauri/binaries/.gitkeep

# Tauri's generated permission schemas.
/src-tauri/gen/

/target/
