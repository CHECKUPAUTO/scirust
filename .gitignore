# Ephemeral agent workflow worktrees (transient, auto-managed)
.claude/worktrees/

# CCOS causal-memory runtime (workspace snapshot + oplog, fed by the
# .claude PostToolUse hook — see docs/CCOS_MEMORY.md). Per-session state.
.ccos/
external/ccos-core/target/
# Verdict written by `ccos setup` — a machine-local install report (host probe,
# absolute paths), regenerated on every run.
setup_report.json

# obd2_api runtime feedback archive (generated locally, not a static asset)
examples/obd2_diagnostic/data/feedback.jsonl

# Python bytecode cache (scripts/, sos/scripts/)
__pycache__/
*.pyc

# Build artifacts
/target/
examples/benchmarks/target/
# scirust-burn-bridge is excluded from the root workspace (it pulls in the real
# Burn crate), so it builds into its own target dir.
scirust-burn-bridge/target/
Cargo.lock
*.rlib
*.so
*.dylib
*.dll

# Compiled binaries (no compiled artifacts in git)
scirust-rustc-driver/scirustc
scirust-rustc-driver/test
scirust-rustc-driver/target/
*.exe
*.out
# Stray test binaries once committed at the repo root — never re-add them.
/cliptest
/cliptest2

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data
/data/
*.bin
*.tar.gz
*.zip

# TurboQuant
.turboquant-backup/
turboquant/
scripts/turboquant-*.sh
systemd/turboquant-*.service

# Cache
.fastembed_cache/

# Logs
*.log

# Temp
*.tmp
*.bak
*.lock
# …but a workspace's Cargo.lock is part of the build it reproduces, and CI
# builds the desktop application with `--locked`. Without this negation the
# blanket `*.lock` above would drop it and every desktop CI job would fail
# on a lock file it was told not to update.
!apps/scirust-studio/Cargo.lock

# CycloneDX SBOMs are generated from Cargo.lock in CI/release and uploaded.
*.cdx.json

# Bundles d'évidence du banc O1 sur Jetson (scripts/bench-o1-jetson.sh) :
# les chiffres sont reportés dans paper/PAPER_PLAN.md et LIVESTATE.md,
# le bundle brut reste sur la machine de mesure.
bench-o1-jetson-*/

# Bundles d'évidence de la preuve cross-platform portable_f32
# (scripts/proof-portable-f32.sh) : verdict et SHA reportés dans LIVESTATE.md,
# le bundle brut reste sur la machine de mesure.
proof-portable-f32-*/

# The fuzz harness is its own cargo workspace and builds into its own target dir.
# corpus/ and artifacts/ are local run byproducts (inputs discovered by
# libFuzzer, crash repros) — not source, not tracked.
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
# scirust-hypermemory is its own nightly-only cargo workspace (excluded from the
# main workspace) and builds into its own target dir.
scirust-hypermemory/target/
proof-certify-*.txt
misrounds-*.txt

# Personal Claude Code local settings (not shared)
.claude/settings.local.json
