{
  "id": "sciagent-opt-smoke-budget-exhausted",
  "goal": "Prove that a correct but sub-threshold candidate produces a report and exits as a failed optimization campaign",
  "crate_name": "scirust-sciagent",
  "backend": "cpu",
  "allowed_paths": [
    "scirust-sciagent/src/optimization_agent",
    "scirust-sciagent/src/bin/sciagent-optimize.rs"
  ],
  "budget": {
    "max_iterations": 1,
    "min_speedup": 1.5,
    "max_abs_error": 0.000001,
    "max_rel_error": 0.000001,
    "command_timeout_secs": 30
  },
  "commands": {
    "baseline": {
      "program": "bash",
      "args": ["scripts/sciagent-opt-smoke.sh", "baseline"]
    },
    "generate": {
      "program": "bash",
      "args": ["scripts/sciagent-opt-smoke.sh", "generate"]
    },
    "compile": {
      "program": "bash",
      "args": ["scripts/sciagent-opt-smoke.sh", "compile"]
    },
    "verify": {
      "program": "bash",
      "args": ["scripts/sciagent-opt-smoke.sh", "verify"]
    },
    "benchmark": {
      "program": "bash",
      "args": ["scripts/sciagent-opt-smoke.sh", "benchmark"]
    },
    "profile": {
      "program": "bash",
      "args": ["scripts/sciagent-opt-smoke.sh", "profile"]
    }
  }
}
