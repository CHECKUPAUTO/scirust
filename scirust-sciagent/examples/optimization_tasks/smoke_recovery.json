{
  "id": "sciagent-opt-smoke-recovery",
  "goal": "Prove that failed generation stages are recorded, invalid candidates are not benchmarked, and later rewrites can recover",
  "crate_name": "scirust-sciagent",
  "backend": "cpu",
  "allowed_paths": [
    "scirust-sciagent/src/optimization_agent",
    "scirust-sciagent/src/bin/sciagent-optimize.rs"
  ],
  "budget": {
    "max_iterations": 3,
    "min_speedup": 1.05,
    "max_abs_error": 0.000001,
    "max_rel_error": 0.000001,
    "command_timeout_secs": 30
  },
  "commands": {
    "baseline": {
      "program": "bash",
      "args": ["scripts/sciagent-opt-smoke.sh", "baseline"]
    },
    "generate": {
      "program": "bash",
      "args": ["scripts/sciagent-opt-smoke.sh", "generate"]
    },
    "compile": {
      "program": "bash",
      "args": ["scripts/sciagent-opt-smoke.sh", "compile"],
      "env": {
        "SCIAGENT_OPT_SMOKE_FAIL_COMPILE_ITER": "1"
      }
    },
    "verify": {
      "program": "bash",
      "args": ["scripts/sciagent-opt-smoke.sh", "verify"],
      "env": {
        "SCIAGENT_OPT_SMOKE_FAIL_VERIFY_ITER": "2"
      }
    },
    "benchmark": {
      "program": "bash",
      "args": ["scripts/sciagent-opt-smoke.sh", "benchmark"],
      "env": {
        "SCIAGENT_OPT_SMOKE_BENCHMARK_MIN_ITER": "3"
      }
    },
    "profile": {
      "program": "bash",
      "args": ["scripts/sciagent-opt-smoke.sh", "profile"]
    },
    "rewrite": {
      "program": "bash",
      "args": ["scripts/sciagent-opt-smoke.sh", "rewrite"]
    }
  }
}
